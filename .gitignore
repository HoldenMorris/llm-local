# Ollama models (cached in Docker volume)
ollama_storage/

# Hashed URL scan cache (page content, screenshots, domain metadata)
.cache/

# Third-party reputation API keys (VirusTotal, urlscan.io) -- .env.sample is committed
.env

# Replay corpus exported from the feedback ledger (./feedback-report.sh --corpus). Live phishing
# URLs embed recipient email addresses and tokens, so this never gets committed or synced.
url-corpus-live.txt

# Results (optional - commit if you want history)
results/*.csv

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temp files
tmp/
temp/
*.tmp
